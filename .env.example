# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset (or sqlite) for local dev.
# For production set this to your PostgreSQL URL:
DATABASE_URL=postgresql://savora:yourpassword@localhost:5432/savora

# ── Kitchen dashboard auth ────────────────────────────────────────────────────
# If set, the dashboard requires ?secret=... in the URL.
# Leave unset to run without auth (dev only).
DASHBOARD_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to * (open) if unset.
# In production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000
